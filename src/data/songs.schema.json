{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Raagroom song library", "type": "object",
  "required": ["version", "songs"],
  "properties": {
    "$schema": { "type": "string" }, "version": { "const": 1 },
    "songs": { "type": "array", "items": {
      "type": "object", "required": ["id", "title", "collection", "difficulty", "composer", "license", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "composer": { "type": "string" },
        "collection": { "enum": ["Original practice", "Original film-inspired", "Bollywood"] }, "difficulty": { "enum": ["Easy", "Intermediate"] },
        "license": { "type": "object", "required": ["kind", "attribution"], "properties": { "kind": { "enum": ["original", "CC0", "CC-BY-4.0", "licensed"] }, "attribution": { "type": "string", "minLength": 1 }, "source": { "type": "string" } } },
        "notes": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "type": "object", "required": ["pitch", "startTime", "duration", "velocity"], "properties": {
          "pitch": { "type": "integer", "minimum": 24, "maximum": 108 }, "startTime": { "type": "number", "minimum": 0, "maximum": 600 },
          "duration": { "type": "number", "minimum": 0.04, "maximum": 30 }, "velocity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        } } }
      }
    } }
  }
}
